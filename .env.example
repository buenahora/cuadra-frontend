VITE_API_BASE_URL=http://127.0.0.1:8000
# Key de CARTO para los tiles del mapa base (https://carto.com/basemaps).
# Sin esto los mapas muestran el cartel "API KEY REQUIRED".
# Es una key de frontend: viaja en el bundle. Restringila por dominio en CARTO.
VITE_CARTO_API_KEY=

# Login con Cognito (outputs AuthDomain y UserPoolClientId del stack del
# backend). Vacíos = login propio con email y contraseña contra la API, que
# es lo que corre en desarrollo. Cargados = el login pasa al hosted UI de
# Cognito, con "Entrar con Google".
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
